# Server
PORT=3000
NODE_ENV=development

# PostgreSQL (Render provides this automatically via fromDatabase)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Admin access — use a long random string
ADMIN_ACCESS_KEY=change-this-to-a-very-long-random-string

# Session cookie secret — another long random string
COOKIE_SECRET=another-very-long-random-string-change-me

# Cloudinary (free tier: 25GB storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
