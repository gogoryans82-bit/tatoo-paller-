# ─── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── PostgreSQL ────────────────────────────────────────────
# Render injects this automatically in production
DATABASE_URL=postgresql://user:password@localhost:5432/tattoo_parlor

# ─── Admin Access (no login form — secret URL only) ────────
ADMIN_ACCESS_KEY=replace-with-a-long-random-string-abc123xyz789
COOKIE_SECRET=replace-with-another-long-random-string-def456uvw012

# ─── Cloudinary (image storage) ────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
